{
  "env": { "node": true, "es2021": true },
  "extends": "eslint:recommended",
  "parserOptions": { "ecmaVersion": 2021 },
  "rules": {
    "no-unused-vars": ["warn", { "args": "none" }],
    "no-empty": "warn",
    "no-constant-condition": "warn"
  },
  "ignorePatterns": ["node_modules/", "public/", "scratch/"]
}
